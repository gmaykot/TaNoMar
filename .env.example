# Variáveis para docker compose / Coolify (PostgreSQL externo).
# Detalhes em docs/deployment.md.

# --- Host ---
TANOMAR_BIND_ADDRESS=127.0.0.1
TANOMAR_PORT=8082

# --- Obrigatórias ---
GOOGLE_CLIENT_ID=
JWT_KEY=
ConnectionStrings__Default=Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>

# --- Admin inicial ---
# E-mail da conta Google. O subject é a claim `sub`, não o e-mail.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_GOOGLE_SUBJECT=

# --- Web Push (opcional) ---
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@localhost

# --- Pesca e locais (opcional) ---
# Tábua de Maré API: https://tabuamare.api.br/docs
# TABUA_MARE_API_KEY=
# Busca de lugares no cadastro: https://www.geoapify.com/
# GEOAPIFY_API_KEY=

# --- Câmeras ao vivo (opcional) ---
# Windy Webcams: https://api.windy.com/webcams/docs
# YouTube Data API v3
# WINDY_WEBCAMS_API_KEY=
# YOUTUBE_API_KEY=
# Webcams__SearchRadiusKm=10
# Webcams__AvailabilityCacheMinutes=15

# --- Cobrança Asaas (opcional) ---
# Sem chave, /premium permanece vitrine e o botão de checkout some.
# A chave do Asaas começa com $aact_. No Docker/Coolify o $ é interpolado e some:
# cole SEM o $ inicial (aact_prod_... ou aact_hmlg_...). A API recoloca o $.
# Local com `dotnet run` aceita a chave completa com $.
# ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3  |  sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_BASE_URL=https://api.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# PUBLIC_APP_ORIGIN=https://app.example.com

# --- Notificações administrativas por e-mail (opcional) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=avisos@example.com
# RESEND_FROM_NAME=TáNoMar
# RESEND_NOTIFICATION_EMAIL=admin@example.com

# --- WhatsApp/Baileys ---
# O token é obrigatório no compose e deve ser igual a INTERNAL_API_KEY em services/tanomar-whatsapp/.env.
WHATSAPP_API_KEY=troque-por-um-token-longo
# Ative para permitir a conexão; o envio só começa após ativar e salvar um destino no Admin.
WHATSAPP_ENABLED=false
# Local: adapter Node. No compose a API usa http://tanomar-whatsapp:3000.
# WHATSAPP_BASE_URL=http://127.0.0.1:3000
# Nome em produção (compose). O adapter local usa TaNoMar-Local e não herda este valor.
WHATSAPP_INSTANCE_NAME=TaNoMar
