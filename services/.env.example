# Stack tanomar-whatsapp + tanomar-monitor
# Copie para services/.env. Nunca versionar valores reais.

WHATSAPP_API_KEY=replace-me
WHATSAPP_INSTANCE_NAME=TaNoMar
WHATSAPP_DESTINATION_ID=5548999999999@s.whatsapp.net
# Timeout HTTP do envio no adapter (não cancela uma operação já entregue ao Baileys).
WHATSAPP_ADAPTER_SEND_TIMEOUT_SECONDS=20

MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
MONITOR_HTTP_TIMEOUT_SECONDS=10
WHATSAPP_STATUS_TIMEOUT_SECONDS=5
WHATSAPP_SEND_TIMEOUT_SECONDS=15
ALERT_RETRY_ENABLED=true
ALERT_RETRY_INTERVAL_SECONDS=300
ALERT_MAX_RETRY_ATTEMPTS=3

TANOMAR_WEB_URL=https://tanomar.app
TANOMAR_WEB_EXPECTED_CONTENT=TaNoMar
TANOMAR_API_URL=https://tanomar.app/health/ready

# Opcional: por padrão o monitor publica somente em loopback do host.
# MONITOR_BIND_ADDRESS=127.0.0.1
# MONITOR_PORT=8081
