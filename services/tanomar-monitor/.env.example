# Intervalo entre rodadas de monitoramento (segundos)
MONITOR_INTERVAL_SECONDS=60

# Falhas consecutivas para considerar Down
MONITOR_FAILURE_THRESHOLD=3

# Sucessos consecutivos para considerar Recovery
MONITOR_RECOVERY_THRESHOLD=2

# Timeout dos checks HTTP Web/API (segundos)
MONITOR_HTTP_TIMEOUT_SECONDS=10

# Timeout da consulta GET /status do WhatsApp (segundos)
WHATSAPP_STATUS_TIMEOUT_SECONDS=5

# Timeout do POST /send do WhatsApp (segundos)
WHATSAPP_SEND_TIMEOUT_SECONDS=15

# Habilita novas tentativas após falha transitória de alerta
ALERT_RETRY_ENABLED=true

# Intervalo mínimo entre tentativas adicionais de alerta (segundos)
ALERT_RETRY_INTERVAL_SECONDS=300

# Número máximo de tentativas adicionais por incidente
ALERT_MAX_RETRY_ATTEMPTS=3

# URLs e persistência
TANOMAR_WEB_URL=https://tanomar.app
TANOMAR_WEB_EXPECTED_CONTENT=TaNoMar
TANOMAR_API_URL=https://tanomar.app/health/ready
MONITOR_DATABASE_PATH=/app/data/tanomar-monitor.db

# WhatsApp — nunca versionar valores reais
WHATSAPP_BASE_URL=http://tanomar-whatsapp:3000
WHATSAPP_API_KEY=replace-me
WHATSAPP_DESTINATION_ID=5548999999999@s.whatsapp.net
